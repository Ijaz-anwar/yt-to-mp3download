# MediaNest Environment Configuration

# Application
NEXT_PUBLIC_APP_NAME="MediaNest"
NEXT_PUBLIC_APP_URL="https://yt-to-mp3.download"
NEXT_PUBLIC_SITE_URL="https://yt-to-mp3.download"
NODE_ENV="production"
PORT=3000

# YouTube Extractor (Python & yt-dlp)
# Leave empty to use system default (`python3` on Linux/macOS, `python` on Windows).
# On cPanel, you can point PYTHON_PATH to your Python 3 binary (e.g., "/usr/bin/python3")
# or point YT_DLP_PATH directly to a standalone yt-dlp executable.
PYTHON_PATH=""
YT_DLP_PATH=""

# Media Engine & FFmpeg Executables (optional if using bundled ffmpeg-static/ffprobe-static or global PATH)
# Windows example: "C:\\Program Files\\ffmpeg\\bin\\ffmpeg.exe"
# Linux example: "/usr/bin/ffmpeg"
FFMPEG_PATH=""
FFPROBE_PATH=""

# Process Management & Worker Concurrency
MAX_CONCURRENT_JOBS=2
MAX_OUTPUT_SIZE_BYTES=524288000
MAX_PROCESSING_TIMEOUT_MS=300000

# Storage & Ephemeral Files (15-Minute Retention Policy)
TEMP_MEDIA_DIR="./.temp_media"
MAX_UPLOAD_SIZE_MB=250
MAX_REMOTE_DOWNLOAD_SIZE_MB=200
MEDIA_JOB_TTL_MS=900000
MEDIA_CLEANUP_INTERVAL_MINUTES=15

# Rate Limiting & Safety
ENABLE_DIRECT_DOWNLOAD=true
ENABLE_SSRF_PROTECTION=true
ALLOWED_MEDIA_PROVIDERS=""
DISABLE_RATE_LIMITS=false
RATE_LIMIT_ANALYZE=30
RATE_LIMIT_UPLOAD=20
RATE_LIMIT_JOB_CREATE=25
RATE_LIMIT_JOB_STATUS=300
RATE_LIMIT_DOWNLOAD=50

# Production Monitoring & Telemetry (Optional)
ERROR_MONITORING_WEBHOOK_URL=""
